# Copy to .env.local in the fact_checking/ directory and fill in your keys.
# 复制为 fact_checking/.env.local 并填入你的密钥。

# DeepSeek (used as the default debate model, e.g. deepseek-chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Alias, optional
DS_KEY=

# Qwen / DashScope (qwen-plus, qwen3.6-plus, etc.)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Alias, optional
QWEN_KEY=

# OpenAI-compatible (gpt-4o-mini, etc.)
OPENAI_API_KEY=your_openai_api_key_here
# Alias, optional
GPT_KEY=

# Tavily web search (optional; duckduckgo is used by default)
TAVILY_API_KEY=your_tavily_api_key_here
